{
  "name": "scoreplay",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @scoreplay/web dev",
    "build": "pnpm catalog:prepare && pnpm --filter @scoreplay/web build",
    "preview": "pnpm --filter @scoreplay/web preview",
    "typecheck": "pnpm --filter @scoreplay/web exec tsc -b",
    "test": "pnpm --filter @scoreplay/web test",
    "catalog:prepare": "node scripts/prepare-catalog.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "type": "module"
}
